# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)
#
# Copy this file to your home directory and fill in real values, e.g.:
#   cp values-secret.yaml.template ~/values-secret-confidential-inference.yaml
#
# These secrets are loaded into Vault on the TRUSTEE cluster. They are projected
# into the Trustee KBS (via ESO, see charts/trustee-config) and released ONLY to
# confidential workloads on the inference cluster that pass remote attestation.
#
# If this is your first time using secrets in Validated Patterns, see:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
# https://validatedpatterns.io/learn/getting-started-secret-management/

version: "2.0"

secrets:
  # Secrets served to attested workloads as KBS resources (default/kbsres1/<field>).
  - name: confidential-inference
    vaultPrefixes:
      - global
    fields:
      # Hugging Face token used by vLLM to pull gated models. Prompted on load;
      # set to a real token, or switch onMissingValue to generate if your model
      # is ungated (vLLM still expects the variable to exist).
      - name: hf-token
        onMissingValue: prompt

  # KBS admin auth key. KBS checks the ES256 PUBLIC key; the matching PRIVATE key
  # is used out-of-band by the admin to register resources/policies with KBS.
  # Generate a keypair before loading secrets, e.g.:
  #   openssl genpkey -algorithm ed25519 > ~/kbs/kbs-private.pem
  #   openssl pkey -in ~/kbs/kbs-private.pem -pubout -out ~/kbs/kbs-public.pem
  - name: kbs-auth
    vaultPrefixes:
      - global
    fields:
      - name: public-key
        path: ~/kbs/kbs-public.pem
